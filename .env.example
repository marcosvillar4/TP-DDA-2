# Copiar a .env y ajustar. NUNCA commitear .env (esta en .gitignore).
# Todos los valores son opcionales: sin .env el stack levanta con valores de demo.

# --- Base de datos ---
DB_NAME=logired
DB_USERNAME=logired
DB_PASSWORD=cambiar-esta-clave
DB_ROOT_PASSWORD=cambiar-esta-clave-root

# --- Backend ---
# Minimo 32 caracteres.
JWT_SECRET=generar-con-openssl-rand-base64-48
ADMIN_SEED_PASSWORD=cambiar-clave-admin
# dev = seed de datos de demo; vacio = sin seed.
SPRING_PROFILES_ACTIVE=dev
# local (sin red) | osm | google
MAPAS_PROVEEDOR=local
# Gmail con contrasena de aplicacion. Vacio = los correos quedan pendientes.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Puertos / URLs ---
BACKEND_PORT=8081
FRONTEND_PORT=3000
PUBLIC_API_URL=http://localhost:8081
MYSQL_PORT=3307
ACTIVEMQ_CONSOLE_PORT=8161
ACTIVEMQ_VERSION=6.1.7
